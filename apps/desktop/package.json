{
  "name": "@deepseek-ai/dsh-desktop",
  "version": "0.1.0",
  "description": "Native desktop lifecycle and shell for DeepSeek Harness.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "prepare-runtime": "../../node_modules/.bin/tsx ../../scripts/prepare-desktop-runtime.ts",
    "package": "pnpm run prepare-runtime && pnpm run build && electron-builder --mac --dir",
    "dist": "pnpm run prepare-runtime && pnpm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mobile-gateway": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      { "from": ".runtime/package.json", "to": "dsh-runtime/package.json" },
      { "from": ".runtime/modules", "to": "dsh-runtime/node_modules" }
    ],
    "mac": {
      "target": [
        "dir"
      ]
    }
  }
}
