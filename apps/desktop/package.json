{
  "name": "@deepseek-ai/dsh-desktop",
  "version": "0.1.1-rc.2",
  "description": "Native desktop lifecycle and shell for DeepSeek Harness.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "out/main/index.js",
  "files": [
    "out",
    ".runtime"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "prepare-runtime": "../../node_modules/.bin/tsx ../../scripts/prepare-desktop-runtime.ts",
    "package": "pnpm run prepare-runtime && pnpm run build && electron-builder --mac --dir",
    "dist": "pnpm run prepare-runtime && pnpm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mobile-gateway": "workspace:^",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".runtime/package.json",
        "to": "dsh-runtime/package.json"
      },
      {
        "from": ".runtime/modules",
        "to": "dsh-runtime/node_modules"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ]
    }
  }
}
